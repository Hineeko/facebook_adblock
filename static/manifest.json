{
  "manifest_version": 3,
  "name": "Ad Blocker for Facebook",
  "version": "3.6.0",
  "description": "High-performance Ad & Clutter Blocker for Facebook with Highlight Mode & Whitelist",
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon48.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
